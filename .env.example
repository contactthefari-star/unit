# UNIT Flight Deck — variables d'environnement (copie ce fichier en .env.local)
# Aucune clé réelle ici : ce fichier sert de documentation.

# --- Notion (pont 2 sens) ---
# Clé d'intégration interne Notion (https://www.notion.so/my-integrations)
NOTION_API_KEY=
# Version de l'API Notion (par défaut 2022-06-28)
NOTION_VERSION=2022-06-28
# Secret partagé pour authentifier les webhooks entrants (header x-unit-signature)
NOTION_WEBHOOK_SECRET=

# --- Bases Notion (database_id, 32 caractères) ---
NOTION_DB_TASKS=
NOTION_DB_CONTENT=
NOTION_DB_CRM=

# --- Bases par membre d'équipe ---
NOTION_DB_ARTHUR=
NOTION_DB_JEREMY=
NOTION_DB_ANDRE=

# Rappel : les noms de propriétés Notion attendus par lib/notion.ts sont
# "Name" (title), "Priorité" (select), "Créneau" (rich_text), "Pôle" (select),
# "Deadline" (rich_text). Adapte-les dans lib/notion.ts si ta base diffère.
